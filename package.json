{
  "name": "law-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.scripts.json",
    "build": "tsx scripts/syncQualityPrompts.ts  && npm run typecheck && vite build",
    "test": "tsx --test tests/**/*.test.ts",
    "debug:online": "tsx scripts/onlineDebugServer.ts",
    "recognition:replay": "tsx scripts/replayRecognition.ts",
    "experiment:mineru-agent": "tsx scripts/experimentMineruAgentCsv.ts",
    "experiment:gemini-pdf-csv": "tsx scripts/experimentGeminiPdfCsv.ts",
    "test:recognition-storage": "tsx scripts/testRecognitionStorage.ts",
    "test:recognition-review": "tsx scripts/testRecognitionReview.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=lawflow",
    "recognition:prompts": "tsx scripts/syncQualityPrompts.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "docx": "^9.2.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.55.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^3.99.0"
  }
}
